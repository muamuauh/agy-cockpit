{
  "agy-cockpit-controller": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node bin/hook.mjs",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node bin/hook.mjs",
        "timeout": 5
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "node bin/hook.mjs",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node bin/hook.mjs",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "edit_file|write_file|run_command|call_mcp_tool|search_web",
        "hooks": [
          {
            "type": "command",
            "command": "node bin/hook.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
